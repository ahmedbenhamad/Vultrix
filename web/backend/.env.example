# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Strix Console
ENVIRONMENT=development           # development | production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ────────────────────────────────────────────────────────────────
# Postgres (recommended). For quick local dev you can also use sqlite:
#   DATABASE_URL=sqlite+pysqlite:///./strix_console.db
DATABASE_URL=postgresql+psycopg://strix:strix@localhost:5432/strix_console

# ── Security ────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── First admin (created on first boot / seed) ──────────────────────────────
FIRST_ADMIN_EMAIL=admin@strix.local
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrator

# ── Strix engine integration ────────────────────────────────────────────────
# Point this at your Strix checkout. When set (and STRIX_FORCE_SIMULATION is
# false), assessments launch the REAL engine and results stream into the DB.
# Leave empty to use the built-in simulation.
STRIX_REPO_PATH=C:/Users/Ahmed/Documents/strix-0.7.0-with_integration/strix-0.7.0
STRIX_IMAGE=strix-sandbox:0.7.2
# Command that starts a scan (shlex-split, cwd = STRIX_REPO_PATH).
# Examples: "strix"  |  "poetry run strix"  |  "python -m strix.interface.main"
STRIX_LAUNCH_CMD=strix
# LLM + key the engine needs (REQUIRED for real runs — Strix exits at startup
# without them). Passed through to the scan subprocess. Also needs Docker running.
STRIX_LLM=openrouter/anthropic/claude-sonnet-5
LLM_API_KEY=
# Nominal duration (seconds) for the progress bar ramp only.
STRIX_EXPECTED_DURATION=900
# Set true to force the simulated engine even when STRIX_REPO_PATH is set.
STRIX_FORCE_SIMULATION=false

# ── AI assistant / RAG proxy (optional) ─────────────────────────────────────
RAG_BASE_URL=http://localhost:8000
ASSISTANT_LLM=openrouter/anthropic/claude-sonnet-5
LLM_API_KEY=
