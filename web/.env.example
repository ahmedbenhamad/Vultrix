# ── Vultrix Console — deployment configuration ────────────────────────────────
# Copy to `.env` next to docker-compose.hub.yml and adjust before launching.

# Image source (defaults shown). Override to pull from a different account/tag.
IMAGE_NAMESPACE=ahmedbenhamad
IMAGE_TAG=latest

# Host port mappings
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Database
POSTGRES_USER=vultrix
POSTGRES_PASSWORD=vultrix
POSTGRES_DB=vultrix_console

# Security — CHANGE THESE for any real deployment
SECRET_KEY=change-me-in-production
FIRST_ADMIN_EMAIL=admin@vultrix.local
FIRST_ADMIN_PASSWORD=ChangeMe123!

# CORS: origins allowed to call the API (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Engine: keep true to run the built-in simulation (no external Strix engine needed).
STRIX_FORCE_SIMULATION=true

# Optional AI assistant / RAG wiring
RAG_BASE_URL=http://localhost:8000
LLM_API_KEY=
